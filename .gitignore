target/
.env

# Temporary directory for transfers
.dist/

# Run log, rewritten on every launch
.ading/last-run.log

# Machine-specific task seed and Agent settings
.ading/seed.json

# Local config and skills for AI tools such as Claude Code; not part of the code
.claude/


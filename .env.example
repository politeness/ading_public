# Local-only configuration: copy to .env in the same directory and fill in real values. .env is not committed to Git; real server addresses, directories, and bucket names live only here.

# Backend the development desktop build connects to; defaults to http://localhost:8080 if unset
ADING_DEV_API_BASE_URL=http://<dev-backend-host>:8080

# OSS bucket for installers (used for packaging, generating the cask, and uploading installers)
ADING_OSS_BUCKET=<bucket-name>

# Public URL prefix for the homepage promo videos (used to generate the homepage)
ADING_SITE_VIDEO_BASE_URL=https://<video-host>

# Used by desktop_mac/scripts/deploy-site.sh to deploy the homepage
ADING_SITE_SERVER=root@<server-host>
ADING_SITE_DIR=<homepage-deploy-dir>

# Used by ops/scripts/deploy.sh to deploy the ops console
ADING_OPS_SERVER=root@<server-host>
ADING_OPS_DIR=<ops-console-deploy-dir>

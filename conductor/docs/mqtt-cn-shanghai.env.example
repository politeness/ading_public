# Replace <instance-id> with the real MQTT instance. This is a configuration example, not an enabled deployment.
ADING_MQTT_ENABLED=false
ADING_MQTT_INSTANCE_ID=<instance-id>
ADING_MQTT_REGION_ID=cn-shanghai
ADING_MQTT_PUBLIC_BROKER_URL=mqtts://<instance-id>.mqtt.aliyuncs.com:8883
# Backend credentials default to existing OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET.
# Backend endpoint and report transport must be verified before enabling MQTT.
# Do not assume a VPC endpoint exists: newly created Serverless instances do not provide one by default.
# Cloud-SDK competing consumers passed on this Serverless instance; standard $share did not.
ADING_MQTT_REPORT_TRANSPORT=cloud
ADING_MQTT_CLOUD_DOMAIN=<instance-id>-server-internet.mqtt.aliyuncs.com
ADING_MQTT_CLOUD_PORT=5672
# Public access approved; no paid VPC dedicated endpoint is required.
ADING_MQTT_BROKER_URL=ssl://<instance-id>.mqtt.aliyuncs.com:8883
# ADING_MQTT_SHARED_SUBSCRIPTION applies only when report transport is mqtt.
ADING_MQTT_SHARED_SUBSCRIPTION=true
